# Para desarrollo local no hace falta tocar esto (usa SQLite por default).
# Para producción con Postgres (ej. Neon), descomenta y pon tu connection string:
# DATABASE_URL=postgresql+psycopg2://usuario:password@host/dbname?sslmode=require

# Token simple para proteger el endpoint que genera el sorteo (solo tú lo usas).
ADMIN_TOKEN=cambia-esto-por-algo-secreto

# Origen(es) permitidos para CORS, separados por coma.
FRONTEND_ORIGINS=http://localhost:5173
